# IdeaStress Configuration (copy to .env — never commit real keys)
IDEASTESS_LLM_PROVIDER=mock
IDEASTESS_LLM_API_KEY=
IDEASTESS_LLM_BASE_URL=https://api.openai.com/v1
IDEASTESS_LLM_MODEL=gpt-4o-mini

IDEASTESS_SEARCH_PROVIDER=mock
IDEASTESS_SEARCH_API_KEY=

IDEASTESS_FETCH_PROVIDER=safe_http
IDEASTESS_DATABASE_PATH=./ideastress.db
IDEASTESS_LOG_LEVEL=INFO

# Hard cost & loop safety limits
IDEASTESS_MAX_SEARCH_CALLS=12
IDEASTESS_MAX_PAGES_FETCHED=20
IDEASTESS_MAX_LLM_CALLS=20
IDEASTESS_MAX_RUNTIME_SECONDS=900
IDEASTESS_MAX_ESTIMATED_COST_USD=2.00

# Real Google Ads CPC -> Implied CAC Falsification (DataForSEO ~$0.09/live task)
IDEASTESS_CPC_PROVIDER=mock
IDEASTESS_DATAFORSEO_LOGIN=
IDEASTESS_DATAFORSEO_PASSWORD=
IDEASTESS_CACHE_DB_PATH=./ideastress_cache.db
